# Style decisions 2026-08-01: default rules (incl. expanded single-line bodies);
# trailing commas forbidden to agree with SwiftLint's trailing_comma rule.
--swiftversion 6.0
--exclude .build
--trailing-commas never
# Opening braces stay on the signature's last line even for multiline declarations,
# agreeing with SwiftLint's opening_brace rule.
--disable wrapMultilineStatementBraces
